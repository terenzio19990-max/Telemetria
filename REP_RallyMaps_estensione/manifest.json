{
  "manifest_version": 3,
  "name": "REP Estensione (Rally-Maps e Live timing)",
  "version": "1.1",
  "description": "Race Engineer Pro: importa le prove da rally-maps.com dal solo link e legge le pagine di live timing per il programma.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://www.rally-maps.com/*", "https://rally-maps.com/*",
    "https://*.alkamelsystems.com/*", "https://*.apex-timing.com/*", "https://*.tsl-timing.com/*",
    "https://*.mylaps.com/*", "https://*.speedhive.com/*", "https://*.race-monitor.com/*",
    "https://*.ficr.it/*", "https://*.getraceresults.com/*", "https://*.wige-livetiming.de/*",
    "https://*.natsoft.com.au/*", "https://*.raceresult.com/*", "https://*.timing71.org/*", "https://*.orbits.it/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["file:///*", "http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
    "js": ["ponte.js"],
    "run_at": "document_idle"
  }],
  "icons": { "128": "icona.png" }
}
